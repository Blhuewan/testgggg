{
  // Nexa Auto — static multi-page site + Paystack checkout API
  "name": "nexa-auto",
  "main": "src/main.js",
  "compatibility_date": "2025-01-01",
  "assets": {
    "directory": "./",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    { "binding": "DB" }
  ],
  "vars": {
    // Admin dashboard password. Saved as the ADMIN_PASSCODE secret to change it.
    "ADMIN_PASSCODE": "9113"
  },
  "secrets": {
    "required": ["PAYSTACK_SECRET_KEY"]
  }
}
